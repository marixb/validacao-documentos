# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o GitHub.

# ---------- IA (opcional) ----------
# Sem estas variáveis o sistema extrai os dados por padrões (expressões regulares).
# Exemplo com Google Gemini (tem plano gratuito; chave em https://aistudio.google.com/apikey):
IA_API_KEY=
IA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
IA_MODELO=gemini-flash-latest

# Exemplo com OpenAI:
# IA_API_KEY=sk-...
# IA_BASE_URL=
# IA_MODELO=gpt-4o-mini

# Exemplo com Ollama (local, gratuito):
# IA_API_KEY=ollama
# IA_BASE_URL=http://localhost:11434/v1
# IA_MODELO=llama3.2

# ---------- Regras de negócio ----------
PRAZO_MAXIMO_DIAS=90
CONFIANCA_MINIMA_OCR=60
TAMANHO_MAXIMO_MB=10
